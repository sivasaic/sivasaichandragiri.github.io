library(tidyverse)
setwd("C:/Users/SCHANDR5/OneDrive - University of Oklahoma/Desktop/Summer 2026_OUHSC/R Intro class/R Final Assisment_7-22-2026")
data.table = read.csv("WBI_all_annot_v0_obs_for Final Assisgment.csv")
data.table
unique(data.table$group)
unique(data.table$celltype)
unique(data.table$subtype)
colnames(data.table)
target_ids <- c("CA1", "CA2", "CA3", "CA4", "WBI-1", "WBI-2", "WBI-3", "WBI-4")
filterd_ids = data.table |>
filter(sampleid %in% target_ids)
unique_count <- n_distinct(filterd_ids$sampleid)
unique_count
celltype_abundance_wide <- table(
filterd_ids$celltype,
filterd_ids$sampleid
) |>
prop.table(margin = 2) |>
(\(x) x * 100)() |>
as.data.frame.matrix() |>
rownames_to_column("celltype")
glimpse(celltype_abundance_wide)
celltype_abundance_wide_subset <- celltype_abundance_wide[, my_cols]
celltype_abundance_wide
celltype_abundance_long <- celltype_abundance_wide %>%
pivot_longer(cols = -celltype, names_to = "sample", values_to = "abudance")
glimpse(celltype_abundance_long)
tiff("plot1.tiff", units = "in", width = 6, height = 6, res = 300)
ggplot(celltype_abundance_long, aes (x = sample, y = abudance, fill = celltype)) + geom_bar(stat = "identity") + scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, 10)) + theme_classic() + labs(x = "sample", y = "Cell Type Abundance (%)", fill = "Cell Type")
dev.off()
savehistory("C:/Users/SCHANDR5/OneDrive - University of Oklahoma/Desktop/Summer 2026_OUHSC/R Intro class/R Final Assisment_7-22-2026/temp.Rhistory")
